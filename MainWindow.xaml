<Window x:Class="PressureTestCalculator.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Pressure Test Drop Calculator" Width="900" Height="620"
 WindowStartupLocation="CenterScreen" Background="#EEF2F6">
 <Grid Margin="28">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
  </Grid.RowDefinitions>

  <StackPanel>
   <TextBlock Text="Pressure Test Drop Calculator" FontSize="28" FontWeight="Bold"/>
   <TextBlock Text="Enter the test pressure and test duration to calculate the estimated pressure-drop allowance."
              Margin="0,6,0,0" Foreground="#5B6573"/>
  </StackPanel>

  <Border Grid.Row="1" Margin="0,28,0,20" Padding="20" Background="White" CornerRadius="10">
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/>
    </Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,14,0">
     <TextBlock Text="Test Pressure (psi)" FontWeight="SemiBold"/>
     <TextBox x:Name="PressureBox" Margin="0,8,0,0" Height="42" FontSize="19" Text="2000"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Margin="14,0,14,0">
     <TextBlock Text="Test Duration (minutes)" FontWeight="SemiBold"/>
     <TextBox x:Name="DurationBox" Margin="0,8,0,0" Height="42" FontSize="19" Text="10"/>
    </StackPanel>
    <Button Grid.Column="2" Content="CALCULATE" Height="42" Margin="14,25,0,0"
            Background="#0B5CAD" Foreground="White" FontWeight="Bold"
            Click="Calculate_Click"/>
   </Grid>
  </Border>

  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

   <Border Background="White" CornerRadius="10" Padding="22">
    <StackPanel>
     <TextBlock Text="Calculated Result" FontSize="21" FontWeight="Bold"/>
     <TextBlock x:Name="PressureResult" Margin="0,24,0,0" FontSize="18"/>
     <TextBlock x:Name="DurationResult" Margin="0,12,0,0" FontSize="18"/>
     <TextBlock x:Name="WaitResult" Margin="0,12,0,0" FontSize="18"/>
     <TextBlock x:Name="RateResult" Margin="0,12,0,0" FontSize="18"/>
     <TextBlock x:Name="DropResult" Margin="0,12,0,0" FontSize="18" FontWeight="Bold"/>
    </StackPanel>
   </Border>

   <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="22">
    <StackPanel>
     <TextBlock Text="Reference Values" FontSize="21" FontWeight="Bold"/>
     <TextBlock Margin="0,18,0,0" Text="500 psi" FontSize="16"/>
     <TextBlock Text="240 sec/psi" Foreground="#5B6573"/>
     <TextBlock Margin="0,10,0,0" Text="1,000 psi" FontSize="16"/>
     <TextBlock Text="120 sec/psi" Foreground="#5B6573"/>
     <TextBlock Margin="0,10,0,0" Text="3,000 psi" FontSize="16"/>
     <TextBlock Text="40 sec/psi" Foreground="#5B6573"/>
     <TextBlock Margin="0,10,0,0" Text="5,000 psi" FontSize="16"/>
     <TextBlock Text="24 sec/psi" Foreground="#5B6573"/>
     <TextBlock Margin="0,10,0,0" Text="10,000 psi" FontSize="16"/>
     <TextBlock Text="12 sec/psi" Foreground="#5B6573"/>
     <TextBlock Margin="0,10,0,0" Text="15,000 psi" FontSize="16"/>
     <TextBlock Text="8 sec/psi" Foreground="#5B6573"/>
    </StackPanel>
   </Border>
  </Grid>
 </Grid>
</Window>
